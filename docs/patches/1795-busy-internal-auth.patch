     async def _handle_active_session_busy_message(self, event: MessageEvent, session_key: str) -> bool:
+        # --- Internal events (e.g. Den Channels trusted deliveries) ---
+        # Internal events are system-generated and must skip user authorization —
+        # matching the cold-path behaviour in _handle_message.  Without this,
+        # trusted Den Gateway deliveries with internal=True and user_id=None
+        # are dropped as unauthorized when the session is busy (#1795).
+        if getattr(event, "internal", False):
+            self._queue_or_replace_pending_event(session_key, event)
+            return True
+
